<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizTrainPlanMapper">

    <resultMap type="BizTrainPlan" id="BizTrainPlanResult">
        <result property="planId"    column="plan_id"    />
        <result property="planYear"    column="plan_year"    />
        <result property="planMonth"    column="plan_month"    />
        <result property="planType"    column="plan_type"    />
        <result property="projectCategory"    column="project_category"    />
        <result property="subject"    column="subject"    />
        <result property="trainLevel"    column="train_level"    />
        <result property="hostDeptId"    column="host_dept_id"    />
        <result property="hostDeptName"    column="host_dept_name"    />
        <result property="audienceScope"    column="audience_scope"    />
        <result property="audienceIds"    column="audience_ids"    />
        <result property="audienceText"    column="audience_text"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizTrainPlanVo">
        select plan_id, plan_year, plan_month, plan_type, project_category, subject, train_level, host_dept_id, host_dept_name, audience_scope, audience_ids, audience_text, status, del_flag, create_by, create_time, update_by, update_time, remark from biz_train_plan
    </sql>

    <select id="selectBizTrainPlanList" parameterType="BizTrainPlan" resultMap="BizTrainPlanResult">
        <include refid="selectBizTrainPlanVo"/>
        <where>
            <!-- 计划月份过滤：兼容旧数据 "6月" 和新数据 "2026年6月" 两种格式 -->
            <choose>
                <when test="planYear != null and planMonth != null and planMonth != ''">
                    and (
                        plan_month LIKE CONCAT(#{planYear}, '年', #{planMonth}, '月', '%')
                        or (plan_year = #{planYear} and plan_month = CONCAT(#{planMonth}, '月'))
                    )
                </when>
                <when test="planYear != null">
                    and (plan_month LIKE CONCAT(#{planYear}, '年', '%') or plan_year = #{planYear})
                </when>
                <when test="planMonth != null and planMonth != ''">
                    and plan_month LIKE CONCAT('%', #{planMonth}, '月')
                </when>
            </choose>
            <if test="planType != null  and planType != ''"> and plan_type = #{planType}</if>
            <if test="projectCategory != null  and projectCategory != ''"> and project_category = #{projectCategory}</if>

            <if test="subject != null  and subject != ''"> and subject like concat('%', #{subject}, '%')</if>

            <if test="trainLevel != null  and trainLevel != ''"> and train_level = #{trainLevel}</if>
            <if test="hostDeptId != null "> and host_dept_id = #{hostDeptId}</if>
            <if test="hostDeptName != null  and hostDeptName != ''"> and host_dept_name like concat('%', #{hostDeptName}, '%')</if>
            <if test="audienceScope != null  and audienceScope != ''"> and audience_scope = #{audienceScope}</if>
            <if test="audienceIds != null  and audienceIds != ''"> and audience_ids = #{audienceIds}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectBizTrainPlanByPlanId" parameterType="Long" resultMap="BizTrainPlanResult">
        <include refid="selectBizTrainPlanVo"/>
        where plan_id = #{planId}
    </select>

    <insert id="insertBizTrainPlan" parameterType="BizTrainPlan" useGeneratedKeys="true" keyProperty="planId">
        insert into biz_train_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="planYear != null">plan_year,</if>
            <if test="planMonth != null">plan_month,</if>
            <if test="planType != null">plan_type,</if>
            <if test="projectCategory != null">project_category,</if>
            <if test="subject != null and subject != ''">subject,</if>
            <if test="trainLevel != null">train_level,</if>
            <if test="hostDeptId != null">host_dept_id,</if>
            <if test="hostDeptName != null">host_dept_name,</if>
            audience_scope,
            <if test="audienceIds != null">audience_ids,</if>
            audience_text,
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="planYear != null">#{planYear},</if>
            <if test="planMonth != null">#{planMonth},</if>
            <if test="planType != null">#{planType},</if>
            <if test="projectCategory != null">#{projectCategory},</if>
            <if test="subject != null and subject != ''">#{subject},</if>
            <if test="trainLevel != null">#{trainLevel},</if>
            <if test="hostDeptId != null">#{hostDeptId},</if>
            <if test="hostDeptName != null">#{hostDeptName},</if>
            #{audienceScope,jdbcType=VARCHAR},
            <if test="audienceIds != null">#{audienceIds},</if>
            #{audienceText,jdbcType=VARCHAR},
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateBizTrainPlan" parameterType="BizTrainPlan">
        update biz_train_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="planYear != null">plan_year = #{planYear},</if>
            <if test="planMonth != null">plan_month = #{planMonth},</if>
            <if test="planType != null">plan_type = #{planType},</if>
            <if test="projectCategory != null">project_category = #{projectCategory},</if>
            <if test="subject != null and subject != ''">subject = #{subject},</if>
            <if test="trainLevel != null">train_level = #{trainLevel},</if>
            <if test="hostDeptId != null">host_dept_id = #{hostDeptId},</if>
            <if test="hostDeptName != null">host_dept_name = #{hostDeptName},</if>
            <if test="audienceScope != null">audience_scope = #{audienceScope},</if>
            <if test="audienceIds != null">audience_ids = #{audienceIds},</if>
            <if test="audienceText != null">audience_text = #{audienceText},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where plan_id = #{planId}
    </update>

    <delete id="deleteBizTrainPlanByPlanId" parameterType="Long">
        delete from biz_train_plan where plan_id = #{planId}
    </delete>

    <delete id="deleteBizTrainPlanByPlanIds" parameterType="String">
        delete from biz_train_plan where plan_id in
        <foreach item="planId" collection="array" open="(" separator="," close=")">
            #{planId}
        </foreach>
    </delete>
</mapper>