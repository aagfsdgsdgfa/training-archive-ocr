<?xml version="1.0" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.biz.mapper.BizSerialCounterMapper">

    <resultMap type="BizSerialCounter" id="BizSerialCounterResult">
        <result property="bizType"    column="biz_type"    />
        <result property="dateKey"    column="date_key"    />
        <result property="currentSeq"    column="current_seq"    />
    </resultMap>

    <!--
        原子自增并返回新序号。
        利用 MySQL 的 INSERT...ON DUPLICATE KEY UPDATE...LAST_INSERT_ID(...) 技巧:
          - 首次插入:LAST_INSERT_ID() 返回插入的 current_seq(初始为 1)
          - 重复更新:LAST_INSERT_ID(expr) 把 expr 的值作为 LAST_INSERT_ID 返回
        配合 selectKey 在同一连接 session 内读取新序号。
    -->
    <insert id="incrementAndGet" parameterType="BizSerialCounter">
        INSERT INTO biz_serial_counter (biz_type, date_key, current_seq)
        VALUES (#{bizType}, #{dateKey}, 1)
        ON DUPLICATE KEY UPDATE current_seq = LAST_INSERT_ID(current_seq + 1)
        <selectKey keyProperty="currentSeq" resultType="long" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

</mapper>
